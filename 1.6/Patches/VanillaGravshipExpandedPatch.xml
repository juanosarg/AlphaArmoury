<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Gravship Expanded - Chapter 1</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/ThingDef[defName = "VGE_Bullet_AnticraftCaster"]</xpath>
					<value>
						<li Class="VEF.Weapons.ProjectileExtension">
							<excludeFromStaticCollection>true</excludeFromStaticCollection>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>